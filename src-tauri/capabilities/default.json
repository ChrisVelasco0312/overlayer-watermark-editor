{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capacidades por defecto de la ventana principal de Overlayer.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "/**" }]
    },
    "opener:allow-open-path"
  ]
}
